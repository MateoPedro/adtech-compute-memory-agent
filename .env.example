ELASTICSEARCH_URL=https://your-project.es.us-east-1.aws.elastic.cloud
ELASTICSEARCH_API_KEY=your-api-key
OPENROUTER_API_KEY=your-openrouter-key
AGENT_ID=team-yourname

# ---- TUNING KNOBS (the challenge) ----
# Recency half-life in days for memory recall:
BRIDGE_MEMORY_DECAY_WINDOW=45
# Fusion: "rrf" (plain FUSE) or "linear" (FUSE LINEAR with weights):
FUSION_STRATEGY=rrf
# Only used when FUSION_STRATEGY=linear. BM25 weight; semantic gets 1 minus this:
FUSION_BM25_WEIGHT=0.3

# ---- AdTech optimizer tuning ----
ADTECH_MEMORY_DECAY_DAYS=180
# Operational records favor exact matches; semantic gets the remainder.
ADTECH_BM25_WEIGHT=0.65

# ---- Movie demo knobs ----
# Taste profile recency half-life (days). 21 = current kick; 180 = stale you:
TASTE_DECAY_DAYS=21
# Window for "recently watched" exclusions (days):
RECENT_WINDOW_DAYS=45

# ---- Optional ----
# GITHUB_TOKEN=ghp_...            # higher rate limits for ingest:issues
ARENA_PORT=4120
MASTRA_URL=http://localhost:4111
# Used by the dashboard in the browser.
NEXT_PUBLIC_ARENA_API=http://localhost:4120
