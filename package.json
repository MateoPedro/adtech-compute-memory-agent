{
  "name": "adtech-compute-memory-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Memory-driven infrastructure optimizer for synthetic AdTech CPU/GPU workloads",
  "type": "module",
  "engines": {
    "node": ">=20.20.0"
  },
  "scripts": {
    "dev": "mastra dev",
    "arena": "tsx src/arena/server.ts",
    "dashboard": "next dev apps/dashboard -p 3001",
    "dev:arena": "concurrently -k -n ARENA,WEB,MASTRA -c cyan,magenta,yellow \"npm:arena\" \"npm:dashboard\" \"npm:dev\"",
    "build:dashboard": "next build apps/dashboard",
    "test": "node --import tsx --test src/arena/*.test.ts",
    "setup": "tsx src/setup-indices.ts",
    "ingest:adtech": "tsx src/ingest-optimization-memories.ts",
    "ingest:auction": "tsx src/ingest-auction-memories.ts",
    "check": "tsc --noEmit",
    "seed:movies": "tsx src/seed-movies.ts",
    "seed:nimbus": "tsx src/seed-memories.ts",
    "seed:sample": "tsx src/seed-sample.ts",
    "ingest:issues": "tsx src/ingest-github-issues.ts",
    "ingest:markdown": "tsx src/ingest-markdown.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.0.0",
    "@mastra/core": "^1.60.0",
    "@mastra/observability": "^1.17.1",
    "dotenv": "^16.4.5",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.0",
    "mastra": "^1.25.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
